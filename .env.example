# Application
CNI_APP_NAME=Criminal Network Intelligence Platform
CNI_ENVIRONMENT=development
CNI_DEBUG=false
CNI_HOST=127.0.0.1
CNI_PORT=8000
CNI_API_PREFIX=/api/v1

# Security
CNI_JWT_SECRET=replace-with-a-long-random-development-secret

# Persistence
# SQLite is the zero-service Windows development default.
# For PostgreSQL, use a URL such as:
# postgresql+psycopg://cni_user:change-me@127.0.0.1:5432/cni
CNI_DATABASE_URL=sqlite:///./backend/data/cni.db
CNI_UPLOAD_DIR=./backend/storage/uploads

# Optional Neo4j adapter (the local MVP can run without it)
CNI_NEO4J_ENABLED=false
CNI_NEO4J_URI=bolt://127.0.0.1:7687
CNI_NEO4J_USER=neo4j
CNI_NEO4J_PASSWORD=change-me

# Optional local LLM (Ollama)
CNI_OLLAMA_ENABLED=false
CNI_OLLAMA_URL=http://127.0.0.1:11434
CNI_OLLAMA_MODEL=llama3.2:3b

# Camera monitoring (face detection only; never face identification)
CNI_CAMERA_DETECTION_ENABLED=true
CNI_CAMERA_DEMO_MODE=false
CNI_CAMERA_DETECTION_COOLDOWN_SECONDS=10
CNI_CAMERA_FRAME_INTERVAL_SECONDS=0.08
CNI_CAMERA_EVIDENCE_PRE_EVENT_FRAMES=2
CNI_CAMERA_EVIDENCE_POST_EVENT_FRAMES=2
CNI_CAMERA_EVIDENCE_CLIP_ENABLED=false
CNI_CAMERA_AUTO_START=false

# Development seed accounts. Change these before any shared deployment.
CNI_SEED_ADMIN_USERNAME=admin
CNI_SEED_ADMIN_PASSWORD=ChangeMe-Admin-2026!
CNI_SEED_ANALYST_USERNAME=analyst
CNI_SEED_ANALYST_PASSWORD=ChangeMe-Analyst-2026!
CNI_SEED_AUDITOR_USERNAME=auditor
CNI_SEED_AUDITOR_PASSWORD=ChangeMe-Auditor-2026!

# Frontend
VITE_API_URL=http://127.0.0.1:8000/api/v1
